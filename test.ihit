struct x{
    name:String,
    age:int
};

fn factorial(n:i64) -> i64{
    let mut ret = n;
    let mut i = 1;
    while i <= n{
        ret *= i;
        if i == 5{
            return ret;
        }
        i += 1;
    }
    return ret;
}

fn main (x: int, z: float) {
let a = 0;
let b = 10;
let y = "pls"; 
for i in a..b{
    println("{}:{}",i,factorial(i));
}


}
